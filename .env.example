# Copy this to .env and fill in your values

# OpenAI API key (required for LLM-powered analysis)
OPENAI_API_KEY=sk-your-key-here

# Which model to use for compliance analysis
COMPLIANCE_MODEL=gpt-4o

# Database URL (defaults to sqlite if not set)
DATABASE_URL=sqlite+aiosqlite:///./compliance.db

# API settings
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false

# Compliance settings
MAX_DOCUMENT_SIZE_MB=50
ANALYSIS_TIMEOUT_SECONDS=120
